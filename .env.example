# Copy to .env and fill in. Never commit .env.
# All settings use the TCA_ prefix.

# development | test | uat | production
TCA_ENVIRONMENT=development

# .NET Tour API and Organisation service (base URLs end with /api)
TCA_TOUR_API_BASE_URL=https://uattourapi.dfccil.com/api
TCA_ORG_API_BASE_URL=https://uatorganization.dfccil.com/api
# Value sent in the DeviceType header (DEC-3; the React app sends "web")
TCA_DEVICE_TYPE=web
# Write endpoints switched on after verification against UAT. Empty = the agent writes no claims.
# Example: ["Claim/SaveRaiseClaimDraft"]
TCA_ENABLED_WRITE_ENDPOINTS=[]
# With saving enabled, save read bills into the tour's draft automatically (false: only on "save draft")
TCA_AUTO_SAVE_BILLS=true
# Bill outcomes never shown to the employee are dropped after this many days
TCA_BILL_REPORT_KEEP_DAYS=14
# A bill still being read after this many minutes is reported once as slow
TCA_BILL_SLOW_MINUTES=15

# Token validation: jwks | introspection | unverified_dev (development only)
TCA_AUTH_MODE=jwks
TCA_OIDC_ISSUER=https://app2.dfccil.com
# Optional; when empty the agent discovers it from {issuer}/.well-known/openid-configuration
TCA_OIDC_JWKS_URL=
TCA_OIDC_AUDIENCE=
TCA_OIDC_REQUIRED_SCOPE=api1
# Introspection endpoint used when TCA_AUTH_MODE=introspection
TCA_OIDC_INTROSPECTION_URL=
# Claim that carries the employee code
TCA_USERID_CLAIM=UserId

# Workflow state (LangGraph checkpoints + workflow registry)
TCA_STATE_DB_PATH=data/agent_state.sqlite

# LLM: fake | openai_compatible | aryaan_gateway   (provider decision pending: DEC-10)
# DFCCIL local LLM: TCA_LLM_PROVIDER=aryaan_gateway, TCA_LLM_BASE_URL=https://aryaanai.dfccil.info/chat-api,
# TCA_LLM_API_KEY=<gateway key>; TCA_LLM_MODEL is not used.
TCA_LLM_PROVIDER=fake
TCA_LLM_BASE_URL=
TCA_LLM_API_KEY=
TCA_LLM_MODEL=

# Browser origins allowed to call the agent
TCA_CORS_ORIGINS=["https://localhost:3001"]
